<?xml version="1.0" encoding="utf-8"?>
<!--(VIV [VMimerInfoV Widget Layout — 2026-10-08])-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <!--(VIV [Widget Header And Wallet Name — 2026-10-12])-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VMimerInfoV"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_wallet_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:text="--"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#BDBDBD"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>
    <!--) VIV [Widget Header And Wallet Name — 2026-10-12])-->

    <!--(VIV [Widget Hashrate — 2026-10-04])-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hashrate"
            android:textSize="15sp"
            android:textColor="#BDBDBD" />

        <TextView
            android:id="@+id/widget_hashrate_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!--(VIV [Widget Hashrate 2 — 2026-10-04])-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hashrate 2"
            android:textSize="15sp"
            android:textColor="#BDBDBD" />

        <TextView
            android:id="@+id/widget_hashrate2_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!--(VIV [Widget Miners — 2026-10-04])-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Miners"
            android:textSize="15sp"
            android:textColor="#BDBDBD" />

        <TextView
            android:id="@+id/widget_miners_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!--(VIV [Widget Paid — 2026-10-04])-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Paid"
            android:textSize="15sp"
            android:textColor="#BDBDBD" />

        <TextView
            android:id="@+id/widget_paid_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!--(VIV [Widget Due — 2026-10-04])-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Due"
            android:textSize="15sp"
            android:textColor="#BDBDBD" />

        <TextView
            android:id="@+id/widget_due_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!--(VIV [Widget Bottom Bar — 2026-10-08])-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!--(VIV [Widget Updated — 2026-10-05])-->
        <TextView
            android:id="@+id/widget_updated_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Оновлено: --"
            android:textSize="11sp"
            android:textColor="#9E9E9E" />
        <!--) VIV [Widget Updated — 2026-10-05])-->

        <!--(VIV [Widget Open App Button — 2026-10-08])-->
        <ImageButton
            android:id="@+id/widget_open_app_button"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_view"
            android:contentDescription="Відкрити"
            android:background="@drawable/widget_refresh_button"
            android:scaleType="centerInside"
            android:padding="8dp" />
        <!--) VIV [Widget Open App Button — 2026-10-08]-->

        <!--(VIV [Widget Refresh Button — 2026-10-06])-->
        <ImageButton
            android:id="@+id/widget_refresh_button"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_assistant_refresh"
            android:contentDescription="Оновити"
            android:background="@drawable/widget_refresh_button"
            android:scaleType="centerInside"
            android:padding="2dp" />
        <!--) VIV [Widget Refresh Button — 2026-10-06]-->

    </LinearLayout>
    <!--) VIV [Widget Bottom Bar — 2026-10-08])-->

</LinearLayout>